# Public URL you browse from — the Worker hostname. Trailing slash required.
FORGE_ROOT_URL=https://git.YOUR-SUBDOMAIN.workers.dev/
FORGE_DOMAIN=git.YOUR-SUBDOMAIN.workers.dev
# true in production (always HTTPS at the edge). Only set false for plain-HTTP local testing.
FORGE_COOKIE_SECURE=true
# Host port to publish on. Leave unset for 3000 (Oracle). Override locally if taken.
FORGE_PORT=3000
# Container name. Override if something else on the host already claims "forgejo".
FORGE_CONTAINER=forgejo
