# Public hostname = the deployed Cloudflare Worker.
FORGE_ROOT_URL=http://127.0.0.1:3002/
FORGE_DOMAIN=127.0.0.1
# Every real access path (Worker, Tailscale) is HTTPS, so secure cookies are correct.
FORGE_COOKIE_SECURE=false
# 3000 is taken by your existing forgejo:9 scratch container.
FORGE_PORT=3002
FORGE_CONTAINER=forgejo-local
