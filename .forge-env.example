# Copy this file to .forge-env and fill in the four values.
#
#   NO QUOTES around values — Docker's --env-file treats quotes as literal
#   characters, so "abc" would become a password containing the quote marks.
#
# From Backblaze: Buckets -> your bucket name, and
# Application Keys -> "Add a New Application Key" scoped to that bucket only.
B2_ACCOUNT_ID=paste_keyID_here
B2_ACCOUNT_KEY=paste_applicationKey_here
RESTIC_REPOSITORY=b2:paste_bucket_name_here:forge

# Your own long passphrase. Generate it in your password manager and SAVE IT
# THERE FIRST — there is no recovery path if this is lost.
RESTIC_PASSWORD=paste_a_long_passphrase_here
